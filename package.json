{
  "name": "cogniate-moodle-lti-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:infra && npm run test:k0 && npm run fitness:lms-names && npm run fitness:rules",
    "fitness:lms-names": "node infra/scripts/fitness/lms-names.mjs",
    "fitness:channel-diff": "node infra/scripts/fitness/channel-diff.mjs",
    "fitness:rules": "node infra/scripts/fitness/rules.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test:unit": "vitest run",
    "test:infra": "node --test 'infra/scripts/*.test.mjs' 'infra/scripts/fitness/*.test.mjs'",
    "test:k0": "vitest run --config tests/ltiaas/k0/vitest.config.mts",
    "build": "npm run build --workspaces --if-present",
    "gen-env": "bash infra/scripts/gen-env.sh",
    "stack:up": "bash infra/scripts/stack-up.sh",
    "stack:down": "bash infra/scripts/stack-down.sh",
    "stack:reset": "bash infra/scripts/stack-reset.sh",
    "stack:restart": "bash infra/scripts/stack-restart.sh",
    "stack:data-backup": "bash infra/scripts/stack-data.sh backup",
    "stack:data-restore": "bash infra/scripts/stack-data.sh restore",
    "stack:data-import": "bash infra/scripts/stack-data.sh import",
    "stack:data-quarantine": "bash infra/scripts/stack-data.sh quarantine",
    "stack:storage-compat": "bash infra/scripts/storage-compat.sh",
    "stack:logs": "bash infra/scripts/stack-logs.sh",
    "seed": "bash infra/scripts/seed.sh",
    "seed:lti-manual": "bash infra/scripts/seed-lti-manual.sh",
    "seed:lti-activity": "bash infra/scripts/seed-lti-activity.sh",
    "e2e:reset": "bash infra/scripts/e2e-reset.sh",
    "demo:prepare": "bash infra/scripts/storage-compat.sh guard && bash infra/scripts/demo-prepare.sh",
    "moodle:cron": "bash infra/scripts/moodle-cron.sh",
    "build-runner": "bash infra/scripts/build-runner.sh watch",
    "stack:doctor": "bash infra/scripts/stack-doctor.sh",
    "demo:users": "bash infra/scripts/storage-compat.sh guard && bash infra/scripts/demo-users.sh",
    "stack:moodle-reach-check": "bash infra/scripts/moodle-reach-check.sh",
    "stack:node-reach-check": "bash infra/scripts/node-reach-check.sh",
    "fixtures:check": "bash infra/scripts/fixtures-check.sh",
    "demo": "bash infra/scripts/storage-compat.sh guard && bash infra/scripts/demo.sh",
    "demo:browser": "bash infra/scripts/storage-compat.sh guard && bash infra/scripts/demo-browser.sh",
    "test:acceptance": "bash infra/scripts/qa-suite.sh acceptance",
    "test:e2e": "bash infra/scripts/qa-suite.sh e2e",
    "dev:web": "node apps/portal/scripts/dev-web.mjs",
    "test:compat": "bash infra/scripts/storage-compat.sh guard && bash infra/scripts/compat-run.sh",
    "ci:local": "bash infra/scripts/ci-local.sh"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
