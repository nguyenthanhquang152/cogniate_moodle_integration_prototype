# Names only. npm run gen-env writes .env with generated values (mode 600). Never commit .env.
# --- secrets (generated) ---
DB_PASS=
MOODLE_ADMIN_PASSWORD=
MOODLE_TEACHER_PASSWORD=
MOODLE_STUDENT_PASSWORD=
MOODLE_STUDENT2_PASSWORD=
LTI_MASTER_KEY=
APP_MASTER_KEY=
# --- public config (gen-env derives the URLs from PUBLIC_PORT; default port 443) ---
PUBLIC_PORT=
PUBLIC_MOODLE_URL=
PUBLIC_LTI_URL=
PUBLIC_APP_URL=
PUBLIC_CONTENT_URL=
# --- optional, not written by gen-env ---
# COMPOSE_PROJECT_NAME=     (default cogniate-stack; use another name for a second checkout)
# STACK_SUBNET=             (default 172.28.0.0/16; must be inside 172.16.0.0/12)
# COURSE_FIXTURES_DIR=      (default docs/raw/data/courses)
