# Names only. npm run gen-env writes .env with generated values (mode 600). Never commit .env.
# --- secrets (generated) ---
DB_PASS=
MOODLE_ADMIN_PASSWORD=
MOODLE_TEACHER_PASSWORD=
MOODLE_STUDENT_PASSWORD=
MOODLE_STUDENT2_PASSWORD=
LTI_MASTER_KEY=
APP_MASTER_KEY=
# --- public config (gen-env writes these). Stack identity: taken from the shell on the first gen-env
#     (defaults: cogniate-stack, 172.28.0.0/16, 443), then kept. The URLs are derived from PUBLIC_PORT. ---
COMPOSE_PROJECT_NAME=
STACK_SUBNET=
PUBLIC_PORT=
PUBLIC_MOODLE_URL=
PUBLIC_LTI_URL=
PUBLIC_APP_URL=
PUBLIC_CONTENT_URL=
# --- optional, not written by gen-env ---
# COURSE_FIXTURES_DIR=      (default docs/raw/data/courses)
# LOG_LEVEL=                (Node services: debug | info | warn | error; default info)
